<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine has no WinForms dependencies, so its sources are compiled here directly
       and the tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\GameOfLife\LifeEngine.cs" Link="Engine\LifeEngine.cs" />
    <Compile Include="..\..\src\GameOfLife\Pattern.cs" Link="Engine\Pattern.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
